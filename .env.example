# Copy this file to .env and fill in real local values. .env is gitignored — never commit it.

# --- PostgreSQL (docker-compose + backend datasource) ---
POSTGRES_DB=opsbridge
POSTGRES_USER=opsbridge
POSTGRES_PASSWORD=changeme

# --- Backend ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/opsbridge
DB_USERNAME=opsbridge
DB_PASSWORD=changeme
JWT_SECRET=changeme-use-a-long-random-value-in-real-envs
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Realtime (websocket push) ---
# All in milliseconds: how long a socket may stay open unauthenticated, and how often SLA
# breaches are re-evaluated.
REALTIME_AUTH_DEADLINE_MS=5000
REALTIME_AUTH_SWEEP_MS=5000
REALTIME_SLA_SWEEP_MS=30000

# --- Email notifications (incident declared) ---
# Leave MAIL_HOST/MAIL_USERNAME/MAIL_PASSWORD blank to run without email: the app starts normally
# and logs one warning at startup instead of sending. Never commit real credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=opsbridge@example.com
# Team intake address that new declarations go to. Comma-separated for more than one.
MAIL_NOTIFY_TO=incidents@example.com

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
